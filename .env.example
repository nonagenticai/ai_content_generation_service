# =============================================================================
# AI Content Generation Service - Development Environment Configuration
# =============================================================================
# Copy to .env and adjust values as needed

# Application
ENVIRONMENT=development
APP_NAME=AI Content Generation Service
APP_VERSION=0.1.0

# Database (PostgreSQL)
DATABASE_URL=postgresql+psycopg://postgres:changeme@localhost:5460/ai_content_generation_service  # pragma: allowlist secret
POSTGRES_POOL_MIN_SIZE=2
POSTGRES_POOL_MAX_SIZE=10
POSTGRES_POOL_TIMEOUT=30
POSTGRES_POOL_RECYCLE=3600
DATABASE_ECHO=false

# Redis
REDIS_URL=redis://localhost:6400/0
REDIS_MAX_CONNECTIONS=10
REDIS_SOCKET_TIMEOUT=5
REDIS_SOCKET_CONNECT_TIMEOUT=5
REDIS_DECODE_RESPONSES=true

# API Settings
API_HOST=0.0.0.0
API_PORT=6310
API_DEBUG=true
API_RELOAD=true
API_CORS_ORIGINS=http://localhost:*,http://127.0.0.1:*

# Authentication
AUTH_ENABLED=false
DEFAULT_TENANT_ID=n8n-dev

# Storage
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./data

# Runway
RUNWAY_API_KEY=
RUNWAY_ENABLED=true

# Kling
KLING_API_KEY=
KLING_ENABLED=true

# Veo (Google)
VEO_API_KEY=
VEO_ENABLED=true

# Sora (OpenAI)
SORA_API_KEY=
SORA_ENABLED=true

# Seedance
SEEDANCE_API_KEY=
SEEDANCE_ENABLED=true

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
LOG_DATE_FORMAT=%Y-%m-%d %H:%M:%S
LOG_JSON_LOGS=false

# =============================================================================
# Docker Overrides (when running inside docker-compose)
# =============================================================================
# DATABASE_URL=postgresql+psycopg://postgres:changeme@ai_content_generation_service_postgres:5432/ai_content_generation_service  # pragma: allowlist secret
# REDIS_URL=redis://ai-content-generation-service-redis:6379/0
# STORAGE_LOCAL_PATH=/app/data
